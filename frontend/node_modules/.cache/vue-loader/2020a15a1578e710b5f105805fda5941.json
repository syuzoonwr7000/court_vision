iv>\n\n    <!-- 分析開始ボタン -->\n    <div class=\"start-analysis\">\n      <button @click=\"startAnalysis\" :disabled=\"isButtonDisabled\">分析開始</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      youtubeUrl: \"\",\n      file: null\n    };\n  },\n  computed: {\n    isButtonDisabled() {\n      return !this.youtubeUrl && !this.file;\n    }\n  },\n  methods: {\n    handleFileUpload(event) {\n      this.file = event.target.files[0];\n    },\n    startAnalysis() {\n      console.log(\"分析開始!\");\n      // ここでバックエンドへのリクエストを送信する処理を追加します。\n    }\n  }\n};\n</script>\n\n<style scoped>\n#app {\n  max-width: 600px;\n  margin: 0 auto;\n  padding: 20px;\n  text-align: center;\n}\n\nh1 {\n  margin-bottom: 20px;\n  font-size: 24px;\n}\n\n.file-upload,\n.youtube-url {\n  margin-bottom: 20px;\n}\n\n.file-upload-label {\n  font-size: 16px;\n}\n\ninput[type=\"file\"],\ninput[type=\"text\"] {\n  padding: 8px;\n  font-size: 16px;\n  width: 100%;\n  margin-top: 10px;\n  box-sizing: border-box;\n}\n\nbutton {\n  padding: 10px 20px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\nbutton:disabled {\n  background-color: #ccc;\n}\n\nbutton:not(:disabled) {\n  background-color: #4CAF50;\n  color: white;\n}\n</style>\n"]}]}